rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/{tripId} {
      // Access control is handled by the client UI; anyone with the trip ID can write.
      allow get, create, update, delete: if true;
      allow list: if false;

      match /photos/{photoId} {
        allow get, create, update, delete: if true;
        allow list: if false;
      }
    }
  }
}
